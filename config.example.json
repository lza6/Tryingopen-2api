{
  "listen_addr": "127.0.0.1:47831",
  "upstream_base_url": "https://www.tryingopen.com",
  "api_keys": [],
  "default_model": "qwen/qwen3.8-27b",
  "fallback_models": [
    "deepseek/deepseek-v4-flash-0731",
    "z-ai/glm-5.2",
    "minimax/minimax-m3"
  ],
  "request_timeout_sec": 120,
  "catalog_refresh_min": 30,
  "proxy_file": "data/proxies.txt",
  "free_proxy_enabled": true,
  "free_proxy_refresh_min": 30,
  "hourly_per_ip": 20,
  "max_attempts": 3,
  "cooldown_map": "0,15,60,120,300",
  "direct_fallback": true,
  "skip_upstream_check": true,
  "redact_logs": true,
  "ui_password": "",            // Web 面板 Basic Auth 密码（空=不鉴权；生产公网务必设置）

  // ── 生产保护（默认全开，可环境变量覆盖）──
  "rate_limit_enabled": true,   // 每 API Key 限流（RATE_LIMIT_ENABLED）
  "rate_limit_requests": 60,    // 窗口内最大请求数（RATE_LIMIT_REQUESTS）
  "rate_limit_window_sec": 3600,// 限流窗口长度秒（RATE_LIMIT_WINDOW_SEC）
  "circuit_breaker_enabled": true, // 上游整体熔断（CB_ENABLED）
  "cb_failure_threshold": 5,    // 连续失败 N 次后 OPEN（CB_FAILURE_THRESHOLD）
  "cb_timeout_sec": 30,         // OPEN 后多久进入 HALF_OPEN 探测（CB_TIMEOUT_SEC）
  "metrics_enabled": true       // /metrics Prometheus 端点（METRICS_ENABLED）
}

